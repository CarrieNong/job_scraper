<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.job_scraper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/carrienon/Desktop/code-project/job_scraper/run_task.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/carrienon/Desktop/code-project/job_scraper</string>

    <key>StandardOutPath</key>
    <string>/Users/carrienon/Desktop/code-project/job_scraper/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/carrienon/Desktop/code-project/job_scraper/logs/launchd_stderr.log</string>

    <!-- Run every day at 08:00 — change Hour/Minute to adjust -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Do not run automatically at load time -->
    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
